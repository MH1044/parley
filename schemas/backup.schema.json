{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parley backup (parley.backup/1)",
  "description": "A learner's progress as backup_export writes it (docs/modules/04-app-shell-and-offline-course.md): settings and every table of parley.sqlite3 but the syllabus items and content answers, which are rebuilt from content/. Every key is required except stories (module 07); export writes every column, and import needs only the columns without a default. The settings object is checked against settings.schema.json separately. Never holds a key, a cache, a recording or a pack file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "app_version", "exported_at", "settings", "courses", "items", "accepted_answers",
    "cards", "review_log", "sessions", "lessons", "judgements", "daily", "freeze_events"
  ],
  "properties": {
    "schema": { "const": "parley.backup/1" },
    "app_version": { "type": "string" },
    "exported_at": { "type": "string" },
    "settings": { "type": "object" },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lang", "syllabus_version", "started_at"],
        "properties": {
          "lang": { "enum": ["es", "fr", "de"] },
          "syllabus_version": { "type": "integer" },
          "pack_version": { "type": ["string", "null"] },
          "started_at": { "type": "integer" },
          "placement_index": { "type": ["integer", "null"] },
          "cefr_estimate": { "type": ["string", "null"] },
          "tested_out": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lang", "skill_id", "kind", "target", "en", "lemmas", "cefr", "source_kind", "created_at"],
        "properties": {
          "id": { "type": "string" },
          "lang": { "enum": ["es", "fr", "de"] },
          "skill_id": { "type": "string" },
          "kind": { "enum": ["vocab", "phrase", "pattern"] },
          "target": { "type": "string" },
          "en": { "type": "array", "items": { "type": "string" } },
          "lemmas": { "type": "array", "items": { "type": "string" } },
          "cefr": { "type": "string" },
          "source_kind": { "enum": ["pack", "conversation", "photo", "media", "course_pack"] },
          "source_ref": { "type": ["string", "null"] },
          "created_at": { "type": "integer" },
          "retired": { "enum": [0, 1] }
        }
      }
    },
    "accepted_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "direction", "norm", "display", "source", "created_at"],
        "properties": {
          "item_id": { "type": "string" },
          "direction": { "enum": ["to_target", "to_en"] },
          "norm": { "type": "string" },
          "display": { "type": "string" },
          "source": { "enum": ["judge", "learner"] },
          "created_at": { "type": "integer" }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "facet", "state"],
        "properties": {
          "item_id": { "type": "string" },
          "facet": { "enum": ["receptive", "productive"] },
          "state": { "enum": ["new", "review", "relearning"] },
          "stability": { "type": ["number", "null"] },
          "difficulty": { "type": ["number", "null"] },
          "due": { "type": ["integer", "null"] },
          "last_review": { "type": ["integer", "null"] },
          "reps": { "type": "integer", "minimum": 0 },
          "lapses": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "review_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "facet", "reviewed_at", "rating", "exercise_type", "verdict", "elapsed_days", "stability_after", "difficulty_after", "session_id"],
        "properties": {
          "id": { "type": "integer" },
          "item_id": { "type": "string" },
          "facet": { "enum": ["receptive", "productive"] },
          "reviewed_at": { "type": "integer" },
          "rating": { "enum": [1, 2, 3, 4] },
          "exercise_type": { "type": "string" },
          "verdict": { "type": "string" },
          "response_ms": { "type": ["integer", "null"] },
          "elapsed_days": { "type": "number" },
          "stability_after": { "type": "number" },
          "difficulty_after": { "type": "number" },
          "session_id": { "type": "string" }
        }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lang", "kind", "started_at", "local_date"],
        "properties": {
          "id": { "type": "string" },
          "lang": { "enum": ["es", "fr", "de"] },
          "kind": { "enum": ["lesson", "review", "placement", "story", "conversation", "media"] },
          "skill_id": { "type": ["string", "null"] },
          "started_at": { "type": "integer" },
          "ended_at": { "type": ["integer", "null"] },
          "local_date": { "$ref": "#/$defs/date" },
          "xp": { "type": "integer", "minimum": 0 },
          "exercises": { "type": "integer", "minimum": 0 },
          "correct": { "type": "integer", "minimum": 0 },
          "cost_micros": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lang", "skill_id", "seq", "origin", "content", "created_at"],
        "properties": {
          "id": { "type": "string" },
          "lang": { "enum": ["es", "fr", "de"] },
          "skill_id": { "type": "string" },
          "seq": { "type": "integer" },
          "origin": { "enum": ["ai", "template", "course_pack"] },
          "prompt_id": { "type": ["string", "null"] },
          "content": { "type": "object" },
          "created_at": { "type": "integer" }
        }
      }
    },
    "stories": {
      "description": "Stories (module 07); optional, so a backup made before them still imports.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lang", "skill_id", "seq", "origin", "content", "created_at"],
        "properties": {
          "id": { "type": "string" },
          "lang": { "enum": ["es", "fr", "de"] },
          "skill_id": { "type": "string" },
          "seq": { "type": "integer" },
          "origin": { "enum": ["ai", "course_pack"] },
          "prompt_id": { "type": ["string", "null"] },
          "content": { "type": "object" },
          "created_at": { "type": "integer" }
        }
      }
    },
    "judgements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "verdict", "corrected", "explanation", "tags", "provider", "created_at"],
        "properties": {
          "key": { "type": "string" },
          "verdict": { "enum": ["correct", "almost", "wrong"] },
          "corrected": { "type": "string" },
          "explanation": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "provider": { "type": "string" },
          "created_at": { "type": "integer" }
        }
      }
    },
    "daily": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_date", "xp", "sessions", "goal_xp"],
        "properties": {
          "local_date": { "$ref": "#/$defs/date" },
          "xp": { "type": "integer", "minimum": 0 },
          "sessions": { "type": "integer", "minimum": 0 },
          "goal_xp": { "type": "integer", "minimum": 0 },
          "frozen": { "enum": [0, 1] }
        }
      }
    },
    "freeze_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_date", "kind", "streak_len"],
        "properties": {
          "id": { "type": "integer" },
          "local_date": { "$ref": "#/$defs/date" },
          "kind": { "enum": ["earned", "used"] },
          "streak_len": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
